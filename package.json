{
  "name": "local-pm",
  "version": "1.0.0",
  "description": "Linear-like project management system with Kanban boards",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3010",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3010",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/seeds/seed-runner.ts",
    "reseed": "npm run seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run test:e2e",
    "migrate:statuses": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/migrations/configurable-statuses.ts",
    "migrate:labels": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/migrations/shared-labels.ts",
    "migrate:cycles": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx src/migrations/cycles.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@payloadcms/db-mongodb": "^3.68.4",
    "@payloadcms/next": "^3.68.4",
    "@payloadcms/richtext-lexical": "^3.68.4",
    "@payloadcms/ui": "^3.68.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "dotenv": "^17.2.3",
    "graphql": "^16.12.0",
    "isomorphic-dompurify": "^4.3.0",
    "lucide-react": "^0.563.0",
    "next": "^15.4.10",
    "payload": "^3.68.4",
    "react": "^19.2.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.1",
    "react-quill-new": "^3.7.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14",
      "disablePostinstall": "true"
    }
  }
}
